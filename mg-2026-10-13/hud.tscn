[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://hud.gd" id="1"]
[ext_resource type="FontFile" path="res://dodge_the_creeps_2d_assets/fonts/Xolonium-Regular.ttf" id="2"]

[sub_resource type="Shortcut" id="Shortcut_start"]
events = [Object(InputEventAction,"action": &"start_game")]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1")

[node name="ScoreLabel" type="Label" parent="."]
offset_left = 120.0
offset_top = 14.0
offset_right = 360.0
offset_bottom = 82.0
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 58
text = "0"
horizontal_alignment = 1

[node name="HealthLabel" type="Label" parent="."]
offset_left = 12.0
offset_top = 88.0
offset_right = 210.0
offset_bottom = 126.0
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 24
text = "HP: 3 / 3"

[node name="Message" type="Label" parent="."]
offset_left = 20.0
offset_top = 245.0
offset_right = 460.0
offset_bottom = 355.0
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 38
text = "Dodge the Creeps!"
